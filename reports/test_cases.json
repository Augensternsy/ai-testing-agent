  {
    "api": "/health",
    "method": "GET",
    "summary": "Health",
    "test_cases": [
      {
        "case_id": "health_001",
        "title": "正常健康检查请求",
        "test_point": "验证无参数GET请求返回200",
        "test_type": "normal",
        "priority": "P0",
        "request": {
          "path_params": {},
          "query_params": {},
          "headers": {},
          "body": {}
        },
        "expected_status": 200,
        "expected_result": "返回200状态码，响应体为JSON格式，包含服务健康状态信息"
      },
      {
        "case_id": "health_002",
        "title": "带无关查询参数请求",
        "test_point": "验证额外查询参数不影响健康检查",
        "test_type": "exception",
        "priority": "P2",
        "request": {
          "path_params": {},
          "query_params": {
            "foo": "bar"
          },
          "headers": {},
          "body": {}
        },
        "expected_status": 200,
        "expected_result": "返回200状态码，忽略无关查询参数，仍返回健康状态"
      },
      {
        "case_id": "health_003",
        "title": "带空查询参数请求",
        "test_point": "验证空查询参数处理",
        "test_type": "boundary",
        "priority": "P2",
        "request": {
          "path_params": {},
          "query_params": {
            "": ""
          },
          "headers": {},
          "body": {}
        },
        "expected_status": 200,
        "expected_result": "返回200状态码，空参数被忽略，服务正常响应"
      },
      {
        "case_id": "health_004",
        "title": "带自定义请求头请求",
        "test_point": "验证额外请求头不影响健康检查",
        "test_type": "exception",
        "priority": "P2",
        "request": {
          "path_params": {},
          "query_params": {},
          "headers": {
            "X-Custom-Header": "test"
          },
          "body": {}
        },
        "expected_status": 200,
        "expected_result": "返回200状态码，忽略自定义请求头，服务正常响应"
      },
      {
        "case_id": "health_005",
        "title": "重复请求健康检查接口",
        "test_point": "验证接口稳定性，连续多次请求",
        "test_type": "normal",
        "priority": "P1",
        "request": {
          "path_params": {},
          "query_params": {},
          "headers": {},
          "body": {}
        },
        "expected_status": 200,
        "expected_result": "每次请求均返回200状态码，响应一致，服务稳定"
      }
    ]
  }
