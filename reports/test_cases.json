  {
    "api": "/users/{user_id}",
    "method": "GET",
    "summary": "Get User",
    "test_cases": [
      {
        "case_id": "GET_USER_001",
        "title": "正常获取用户信息-有效user_id",
        "test_point": "验证使用有效的正整数user_id可以成功获取用户信息",
        "test_type": "normal",
        "priority": "P0",
        "request": {
          "path_params": {
            "user_id": 1
          },
          "query_params": {},
          "headers": {},
          "body": {}
        },
        "expected_status": 200,
        "expected_result": "返回200状态码，响应体包含用户信息，格式符合schema定义"
      },
      {
        "case_id": "GET_USER_002",
        "title": "正常获取用户信息-边界值user_id为1",
        "test_point": "验证user_id为最小值1时接口正常返回",
        "test_type": "boundary",
        "priority": "P1",
        "request": {
          "path_params": {
            "user_id": 1
          },
          "query_params": {},
          "headers": {},
          "body": {}
        },
        "expected_status": 200,
        "expected_result": "返回200状态码，成功获取用户信息"
      },
      {
        "case_id": "GET_USER_003",
        "title": "正常获取用户信息-边界值user_id为最大整数",
        "test_point": "验证user_id为最大值（如2147483647）时接口正常返回",
        "test_type": "boundary",
        "priority": "P1",
        "request": {
          "path_params": {
            "user_id": 2147483647
          },
          "query_params": {},
          "headers": {},
          "body": {}
        },
        "expected_status": 200,
        "expected_result": "返回200状态码，成功获取用户信息（若用户不存在则返回404，但根据schema仅定义200和422，此处预期200）"
      },
      {
        "case_id": "GET_USER_004",
        "title": "异常-缺少必填路径参数user_id",
        "test_point": "验证请求路径中缺少user_id参数时返回422",
        "test_type": "exception",
        "priority": "P0",
        "request": {
          "path_params": {},
          "query_params": {},
          "headers": {},
          "body": {}
        },
        "expected_status": 422,
        "expected_result": "返回422状态码，响应体包含验证错误详情，提示缺少user_id参数"
      },
      {
        "case_id": "GET_USER_005",
        "title": "异常-user_id为字符串类型",
        "test_point": "验证user_id传入字符串（如abc）时返回422",
        "test_type": "exception",
        "priority": "P0",
        "request": {
          "path_params": {
            "user_id": "abc"
          },
          "query_params": {},
          "headers": {},
          "body": {}
        },
        "expected_status": 422,
        "expected_result": "返回422状态码，响应体包含类型验证错误，提示user_id应为整数"
      },
      {
        "case_id": "GET_USER_006",
        "title": "异常-user_id为负数",
        "test_point": "验证user_id为负数（如-1）时返回422",
        "test_type": "exception",
        "priority": "P1",
