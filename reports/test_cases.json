  {
    "api": "/health",
    "method": "GET",
    "summary": "Health",
    "test_cases": [
      {
        "case_id": "health_001",
        "title": "正常请求健康检查接口",
        "test_point": "验证GET /health在无参数情况下返回200",
        "test_type": "normal",
        "priority": "P0",
        "request": {
          "path_params": {},
          "query_params": {},
          "headers": {},
          "body": {}
        },
        "expected_status": 200,
        "expected_result": "接口返回200状态码，响应体为JSON格式，包含服务健康状态信息（如status: ok）"
      },
      {
        "case_id": "health_002",
        "title": "带无关query参数请求",
        "test_point": "验证接口对未定义query参数的容忍性",
        "test_type": "exception",
        "priority": "P2",
        "request": {
          "path_params": {},
          "query_params": {
            "foo": "bar"
          },
          "headers": {},
          "body": {}
        },
        "expected_status": 200,
        "expected_result": "接口忽略未定义参数，仍返回200健康状态"
      },
      {
        "case_id": "health_003",
        "title": "带空query参数请求",
        "test_point": "验证空query参数对接口的影响",
        "test_type": "exception",
        "priority": "P2",
        "request": {
          "path_params": {},
          "query_params": {
            "": ""
          },
          "headers": {},
          "body": {}
        },
        "expected_status": 200,
        "expected_result": "接口忽略空参数，返回200健康状态"
      },
      {
        "case_id": "health_004",
        "title": "带自定义header请求",
        "test_point": "验证额外header不影响健康检查",
        "test_type": "exception",
        "priority": "P2",
        "request": {
          "path_params": {},
          "query_params": {},
          "headers": {
            "X-Custom-Header": "test"
          },
          "body": {}
        },
        "expected_status": 200,
        "expected_result": "接口忽略自定义header，返回200健康状态"
      },
      {
        "case_id": "health_005",
        "title": "重复请求健康检查接口",
        "test_point": "验证接口的幂等性和稳定性",
        "test_type": "normal",
        "priority": "P1",
        "request": {
          "path_params": {},
          "query_params": {},
          "headers": {},
          "body": {}
        },
        "expected_status": 200,
        "expected_result": "连续多次请求均返回200，响应内容一致，服务状态稳定"
      }
    ]
  }
]